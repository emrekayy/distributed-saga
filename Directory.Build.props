<Project>
  <!-- Solution'daki TÜM projelere uygulanır. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Çalıştırılabilir/test projeleri: .NET 9 runtime varsa onu kullanır, yoksa bir üst major
      runtime'a (yerelde .NET 10) geçer. Hedef framework net9.0 olarak kalır.
    -->
    <RollForward>Major</RollForward>

    <!-- Kalite kapısı: uyarılar build'i kırar -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- Deterministik build (CI) -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
