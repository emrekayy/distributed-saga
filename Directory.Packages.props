<Project>
  <!--
    Central Package Management: sürümler YALNIZCA burada tanımlanır,
    .csproj dosyalarında <PackageReference Include="..." /> sürümsüz yazılır.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Messaging">
    <!--
      ÖNEMLİ: MassTransit v9 ticari lisanslıdır. v8 açık kaynak (Apache 2.0) olarak
      kalıyor. Bu proje bilinçli olarak v8 hattında tutulur; v9'a yükseltmeyin.
      Güncel 8.x yamasını görmek için "dotnet list package" komutunu outdated
      seçeneğiyle çalıştırın (XML yorumunda çift tire kullanılamaz).
    -->
    <PackageVersion Include="MassTransit" Version="8.5.11" />
    <PackageVersion Include="MassTransit.RabbitMQ" Version="8.5.11" />
    <PackageVersion Include="MassTransit.EntityFrameworkCore" Version="8.5.11" />
  </ItemGroup>

  <ItemGroup Label="Scheduling">
    <!-- Saga timeout'ları: MassTransit.Quartz (in-process) + Postgres job store (order_db, "quartz" şeması). -->
    <PackageVersion Include="MassTransit.Quartz" Version="8.5.11" />
    <PackageVersion Include="Quartz" Version="3.22.6" />
    <PackageVersion Include="Quartz.Extensions.Hosting" Version="3.22.6" />
    <PackageVersion Include="Quartz.Serialization.SystemTextJson" Version="3.22.6" />
  </ItemGroup>

  <ItemGroup Label="Persistence">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="9.0.21" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.21" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup Label="API">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="9.0.21" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="9.0.21" />
  </ItemGroup>

  <ItemGroup Label="Observability">
    <!-- OTLP (Jaeger: trace, Prometheus: metrik). Npgsql.OpenTelemetry, çözümlenen Npgsql sürümüyle (9.0.3) aynı hatta tutulur. -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.0" />
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="9.0.5" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="9.0.21" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.21" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.16.0" />
  </ItemGroup>
</Project>
