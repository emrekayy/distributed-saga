# Bu dosyayı .env olarak kopyalayın. .env git'e GİRMEZ (.gitignore).
# Yalnızca yerel geliştirme içindir; canlıda secret store (Vault, Azure Key Vault vb.) kullanılır.

# --- PostgreSQL (admin) ---
POSTGRES_ADMIN_USER=saga_admin
POSTGRES_ADMIN_PASSWORD=ChangeMe_Admin_123!
POSTGRES_PORT=5432

# --- Servis veritabanları (her servise ayrı kullanıcı) ---
ORDER_DB_NAME=order_db
ORDER_DB_USER=order_svc
ORDER_DB_PASSWORD=ChangeMe_Order_123!

STOCK_DB_NAME=stock_db
STOCK_DB_USER=stock_svc
STOCK_DB_PASSWORD=ChangeMe_Stock_123!

PAYMENT_DB_NAME=payment_db
PAYMENT_DB_USER=payment_svc
PAYMENT_DB_PASSWORD=ChangeMe_Payment_123!

# --- RabbitMQ ---
RABBITMQ_USER=saga
RABBITMQ_PASSWORD=ChangeMe_Rabbit_123!
RABBITMQ_VHOST=saga
RABBITMQ_AMQP_PORT=5672
RABBITMQ_UI_PORT=15672

# --- pgAdmin (opsiyonel, --profile tools) ---
PGADMIN_EMAIL=admin@saga.local
PGADMIN_PASSWORD=ChangeMe_PgAdmin_123!
PGADMIN_PORT=5050
