root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,props,targets,xml}]
indent_size = 2

[*.sh]
end_of_line = lf

[*.cs]
# Namespace
csharp_style_namespace_declarations = file_scoped:warning
# var kullanımı
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
# İsimlendirme: private alanlar _camelCase
dotnet_naming_rule.private_fields.symbols = private_fields_sym
dotnet_naming_rule.private_fields.style = underscore_camel
dotnet_naming_rule.private_fields.severity = warning
dotnet_naming_symbols.private_fields_sym.applicable_kinds = field
dotnet_naming_symbols.private_fields_sym.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _
# Async
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CS4014.severity = error
